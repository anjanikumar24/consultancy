[Unit]
Description=Bhumi Pathways Django site (gunicorn)
After=network.target

[Service]
User=bhumi
Group=www-data
WorkingDirectory=/srv/bhumi
EnvironmentFile=/srv/bhumi/.env
ExecStart=/srv/bhumi/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/bhumi/gunicorn.sock --timeout 30
RuntimeDirectory=bhumi
Restart=on-failure

[Install]
WantedBy=multi-user.target
