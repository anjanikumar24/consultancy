# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=bhumipathwaysconsultancy.com,www.bhumipathwaysconsultancy.com
# CSRF_TRUSTED_ORIGINS=https://bhumipathwaysconsultancy.com,https://www.bhumipathwaysconsultancy.com
# DJANGO_SECURE_SSL_REDIRECT=True
# BEHIND_PROXY=True

# Database: SQLite (db.sqlite3) is the default. Nothing to configure.

# Email. Dev: console backend prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bhumi Pathways <no-reply@bhumipathwaysconsultancy.com>
# Comma-separated staff inboxes. If empty, the "Notification emails" field in Admin > Site settings is used.
ENQUIRY_NOTIFY_EMAILS=
ENQUIRY_SEND_ACKNOWLEDGEMENT=True
# Max accepted enquiries per IP per hour
ENQUIRY_RATE_LIMIT=10
